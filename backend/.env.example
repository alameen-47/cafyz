# Turso (libSQL) — get from https://turso.tech/app
TURSO_URL=libsql://your-db.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT — use a long random string in production (Render can auto-generate)
JWT_SECRET=change-me-in-production

# Founder credentials (only founder account should access /founder)
FOUNDER_EMAIL=founder@cafyz.io
FOUNDER_PASSWORD=change-me-founder-password

# App Store / Play Store reviewer demo (auto-created on API boot)
STORE_DEMO_EMAIL=reviewer@cafyz.com
STORE_DEMO_PASSWORD=CafyzReview2026!
# STORE_DEMO_ENABLED=false

# Public web app URL (password-reset links, inquiry emails). Local dev:
APP_URL=http://localhost:5173

# Free trial length for new signups (days)
TRIAL_DAYS=3

# Anti-abuse: block repeated trial requests from same device/IP (days)
TRIAL_REQUEST_COOLDOWN_DAYS=30

# Comma-separated allowed CORS origins
ALLOWED_ORIGIN=https://cafyz.ametronyx.com,http://localhost:5173,http://localhost:5174

PORT=4000

# ── Google Sign-In ──────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID.
# Create ONE PER PLATFORM; each issues tokens with its own `aud`, and the API
# accepts any that are set here. Leave all unset to disable Google sign-in.
#
#   Web application     → authorised origins: https://cafyz.ametronyx.com,
#                         http://localhost:5173
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
#   Android             → needs the signing SHA-1 of your release keystore
# GOOGLE_CLIENT_ID_ANDROID=xxxxx.apps.googleusercontent.com
#   iOS                 → bundle id from cap-ios
# GOOGLE_CLIENT_ID_IOS=xxxxx.apps.googleusercontent.com

# ── Online payments master switch ───────────────────────────────────────────────
# Off by default. While false, the Purchase/Renew buttons email the founder and
# the license is issued from the founder panel. Set to true ONLY once Razorpay
# KYC is approved and LIVE keys are set below (both are required).
# ONLINE_PAYMENTS_ENABLED=true

# ── Razorpay (subscription payments — Standard Checkout / Orders API) ─────────────
# Dashboard → Account & Settings → API Keys → Generate Key.
# Use TEST keys (rzp_test_...) first; swap for LIVE keys (rzp_live_...) at go-live.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_key_secret
# Webhook secret: Dashboard → Settings → Webhooks → add https://<api>/api/billing/webhook
# subscribe to payment.captured + order.paid, set a secret, paste it here:
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Push notifications (FCM legacy server key for Android/iOS native apps) ─────
# Firebase Console → Project Settings → Cloud Messaging → Server key
# FIREBASE_SERVER_KEY=your_fcm_server_key

# Trial / subscription renewal emails — 10:00 & 18:00 local time, 3 days before expiry
# TRIAL_REMINDER_CHECK_MS=60000
# TRIAL_REMINDER_ENABLED=true

# ── Cloudinary (menu item photos) ───────────────────────────────────────────────
# Dashboard: https://console.cloudinary.com → copy Cloud name, API Key, API Secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional folder prefix (default: cafyz/menu)
# CLOUDINARY_MENU_FOLDER=cafyz/menu

# ── Email (production on Render FREE tier: use Resend — SMTP ports are blocked) ──
#
# Resend setup:
#   1. https://resend.com → API Keys → create key → RESEND_API_KEY=re_...
#   2. For quick testing (no domain): RESEND_FROM=Cafyz <onboarding@resend.dev>
#      (can only send to the email you signed up with until you verify a domain)
#   3. For production: Domains → verify ametronyx.com → RESEND_FROM=Cafyz <noreply@ametronyx.com>
#   4. Copy the same vars to Render → Environment → redeploy
#
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_key_here
# Verified subdomain on Resend (cafyz.ametronyx.com — NOT root ametronyx.com unless that is verified too)
RESEND_FROM=Cafyz <noreply@cafyz.ametronyx.com>
RESEND_SENDER_EMAIL=noreply@cafyz.ametronyx.com

# Optional: Brevo (if not using Resend)
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=your-verified@gmail.com
# BREVO_SENDER_NAME=Cafyz

# Gmail SMTP — local dev fallback only (blocked on Render free tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=Cafyz


